" vim: ft=vim

" Colors (Alacritty Theme Match)
set default-bg              "#000000"
set default-fg              "#e6e6e6"
set statusbar-bg            "#0d0d0d"
set statusbar-fg            "#e6e6e6"
set inputbar-bg             "#000000"
set inputbar-fg             "#e6e6e6"
set notification-error-bg   "#0d0d0d"
set notification-error-fg   "#e55a5a"
set notification-warning-bg "#0d0d0d"
set notification-warning-fg "#d4af37"
set highlight-color         "#d4af37"
set highlight-active-color  "#5cb370"
set completion-highlight-bg "#42a5c7"
set completion-highlight-fg "#000000"
set completion-bg           "#0d0d0d"
set completion-fg           "#e6e6e6"
set notification-bg         "#0d0d0d"
set notification-fg         "#e6e6e6"
set recolor                 "true"
set recolor-lightcolor      "#000000"
set recolor-darkcolor       "#e6e6e6"
set recolor-reverse-video   "true"
set recolor-keephue         "false"

" Clipboard
set selection-clipboard clipboard

" Search
set incremental-search true
set search-hadjust true

" Autoadjust
set adjust-open width

" Typography
set font "JetbrainsMono Nerd Font 12"

" Keymaps
map [normal]     i set recolor
map [fullscreen] i set recolor
map [normal]     b toggle_statusbar
map [fullscreen] b toggle_statusbar
map [normal]     D toggle_page_mode
map [fullscreen] D toggle_page_mode
